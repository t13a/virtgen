.DELETE_ON_ERROR:
MAKEFLAGS += --no-builtin-rules --no-builtin-variables --warn-undefined-variables
SHELL := bash
.SHELLFLAGS := -euo pipefail -O nullglob -c
# The index is committed, so the order of its entries must not depend on the locale.
export LC_ALL := C

JSONNET ?= jsonnet
VIRT_XML_VALIDATE ?= virt-xml-validate
CLOUD_INIT ?= cloud-init
REGISTRY_DIR ?= /mnt/registry
PROVISIONERS_DIR ?= /mnt/provisioners
CODE ?= render(registry)

$(foreach v,REGISTRY_DIR PROVISIONERS_DIR,$(if $(strip $($(v))),,$(error $(v) is empty)))

INDEX := $(REGISTRY_DIR)/index.libsonnet
TMP_DIR := $(PROVISIONERS_DIR)/.tmp
changed = $$(for f in $(TMP_DIR)/$(1); do cmp -s $$f $(PROVISIONERS_DIR)/$${f\#$(TMP_DIR)/} || echo $$f; done)

.PHONY: gen print $(INDEX)
gen: $(INDEX)
	rm -rf $(TMP_DIR)
	$(JSONNET) -S -c -m $(TMP_DIR) --tla-code-file registry=$(INDEX) main.jsonnet > /dev/null
	for f in $(call changed,*/domain.xml); do $(VIRT_XML_VALIDATE) $$f domain; done
	for f in $(call changed,*/pools/*.xml); do $(VIRT_XML_VALIDATE) $$f storagepool; done
	for f in $(call changed,*/volumes/*/*.xml); do $(VIRT_XML_VALIDATE) $$f storagevol; done
	if command -v $(firstword $(CLOUD_INIT)) > /dev/null; then \
	  for f in $(call changed,*/*.d/user-data); do $(CLOUD_INIT) schema -c $$f; done; \
	else \
	  echo 'warning: $(firstword $(CLOUD_INIT)) not found, so user-data was not validated' >&2; \
	fi
	rm -rf $(PROVISIONERS_DIR)/*
	mv $(TMP_DIR)/* $(PROVISIONERS_DIR)/
	rmdir $(TMP_DIR)

# CODE reaches jsonnet through the environment, so neither make nor the shell changes it.
unexport CODE
print: override export CODE := $(value CODE)
print: $(INDEX)
	@$(JSONNET) --ext-code-file registry=$(INDEX) --ext-code-file render=main.jsonnet \
	  -e "local registry = std.extVar('registry'), render = std.extVar('render'); $$CODE"

$(INDEX):
	@{ echo '// Generated by `make` from the directories next to it. Do not edit.'; echo '{'; \
	  for d in $(REGISTRY_DIR)/*/; do d=$$(basename $$d); \
	    if [ $$d = vms ]; then echo "  $$d: {"; else echo "  $$d:: {"; fi; \
	    for f in $(REGISTRY_DIR)/$$d/*.libsonnet; do n=$$(basename $$f .libsonnet); \
	      if [ $$d = vms ]; then echo "    '$$n': (import '$$d/$$n.libsonnet') + { name: '$$n' },"; \
	      else echo "    '$$n': import '$$d/$$n.libsonnet',"; fi; \
	    done; \
	    echo '  },'; done; \
	  echo '}'; } > $@
